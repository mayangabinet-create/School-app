# The browser needs these two, and only these two.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Set on the Edge Function, never here and never in the browser:
#   ANTHROPIC_API_KEY
#   SUPABASE_SERVICE_ROLE_KEY   (Supabase provides this to the function)
#   APP_ORIGIN                  (the site's origin, so CORS is not a wildcard)
